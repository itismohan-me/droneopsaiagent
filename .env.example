# ============================================================================
# DRONE OPERATIONS AI AGENT - ENVIRONMENT CONFIGURATION
# ============================================================================

# ==== APPLICATION SETTINGS ====
ENVIRONMENT=development
DEBUG=true

# ==== BACKEND API CONFIGURATION ====
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ==== FRONTEND CONFIGURATION ====
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# ==== GOOGLE SHEETS INTEGRATION ====
# Set to 'true' to enable Google Sheets syncing (requires credentials setup)
USE_GOOGLE_SHEETS=true

# Google Sheets ID (from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
# Set this to the sheet ID you shared
GOOGLE_SHEETS_ID=1H7zd4Pb25Xp_KB72l0ZZVycxpUB2kGXz0sBwNvUearw

# Path to Google Service Account credentials JSON file
# Download from Google Cloud Console after setting up Service Account
GOOGLE_CREDENTIALS_PATH=./credentials/gsheet_credentials.json

# Optional: Google Cloud Project ID
GOOGLE_PROJECT_ID=

# Sheet names (must exist as tabs in the Google Sheet)
PILOT_SHEET_NAME=pilots_roaster
DRONE_SHEET_NAME=drone_fleet

MISSIONS_SHEET_NAME=missions

# Sync frequency and settings
SYNC_INTERVAL_SECONDS=300
AUTO_SYNC_ENABLED=false

# ==== DATABASE CONFIGURATION (OPTIONAL) ====
# For future production deployment
# DATABASE_URL=postgresql://user:password@localhost/droneops
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ==== AI/LLM CONFIGURATION (OPTIONAL) ====
# For advanced AI features (future enhancement)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_TEMPERATURE=0.7

# ==== LOGGING & MONITORING ====
LOG_LEVEL=INFO
LOG_FILE=logs/droneops.log
ENABLE_SYNC_LOG=true

# ==== DEPLOYMENT SETTINGS ====
RAILWAY_ENVIRONMENT=development
DEPLOYMENT_MODE=local

# ==== SECURITY (PRODUCTION ONLY) ====
# SECRET_KEY=your-super-secret-key-change-in-production
# CORS_ORIGINS=https://frontend.domain.com
# JWT_ENABLED=false
# API_KEY_ENABLED=false
# API_KEY=your_api_key_here

# ==== MONITORING & ANALYTICS (OPTIONAL) ====
# SENTRY_DSN=
# SLACK_WEBHOOK_URL=
# DATADOG_API_KEY=

# ==== FEATURE FLAGS ====
ENABLE_CONFLICT_DETECTION=true
ENABLE_URGENT_REASSIGNMENTS=true
ENABLE_ANALYTICS=true
ENABLE_GOOGLE_SHEETS_SYNC=true

# ==== CSV DATA PATHS (LOCAL DEVELOPMENT) ====
CSV_DATA_PATH=./data
PILOTS_CSV=pilot_roster.csv
DRONES_CSV=drone_fleet.csv
MISSIONS_CSV=missions.csv
